.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg);
  border-top: none;
  box-shadow: 0 -2rpx 12rpx rgba(80, 70, 90, 0.08);
  display: flex;
  box-sizing: content-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.tab-item.active .tab-text {
  color: var(--color-primary-deep);
  font-weight: 600;
}
