/* ============================================================
   统一设计 Token V2（docs/15-新UI设计规范.md）
   轻奢高级简约 · 随时节动态换肤
   动态层只替换：bg / surface / grad / text-soft / festival-accent / 背景纹理
   固定层：主按钮色、正文色、分类语义色
   ============================================================ */
page {
  /* 固定品牌与文字 */
  --color-primary: #F08A9B;
  --color-primary-deep: #DD6F84;
  --color-text: #3D3A3E;
  --color-text-secondary: #A5A1A8;
  --color-danger: #DE6B7C;

  /* 动态层（白天默认） */
  --color-bg: #FAF8F4;
  --color-surface: #FFFFFF;
  --grad-a: #FAF8F4;
  --grad-b: #F1EFEA;
  --color-border: #EDE9E4;
  --color-text-soft: #A5A1A8;
  --festival-accent: #F08A9B;

  /* 分类语义色（固定） */
  --color-todo: #B8B4BC;
  --color-meal: #E0A26B;
  --color-restaurant: #E18FA0;
  --color-anniversary: #D96E80;
  --color-travel: #7FA8C9;
  --color-period: #D96E80;
  --color-rest: #7FA8C9;
  --color-accent: #E0A26B;
  --color-blue: #7FA8C9;
  --color-red: #D96E80;
  --color-success: #A8D8B9;
  --color-purple: #B48AB5;
  --color-mint: #7FB5AE;

  /* 分类标签浅色底（同色系不同明度） */
  --tag-todo: #EFEDF1;
  --tag-meal: #F6E7D8;
  --tag-restaurant: #F8E6EA;
  --tag-anniversary: #F7E2E6;
  --tag-travel: #E3ECF3;
  --tag-period: #F7E2E6;
  --tag-rest: #E3ECF3;

  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;

  /* 间距 */
  --space-xs: 4rpx;
  --space-sm: 8rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-xxl: 48rpx;

  /* 阴影（低透明大模糊） */
  --shadow-card: 0 8rpx 32rpx rgba(80, 70, 90, 0.06);
  --shadow-soft: 0 4rpx 16rpx rgba(80, 70, 90, 0.05);
  --shadow-float: 0 12rpx 48rpx rgba(80, 70, 90, 0.12);

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

