/* 统一设计 Token：与 packages/design-tokens 保持一致（第九阶段：韩风可爱风） */
page {
  --color-bg: #FFF7F0;
  --color-surface: #FFFFFF;
  --color-text: #4E4547;
  --color-text-secondary: #B9A8A0;
  --color-border: #F6E8DC;
  --color-primary: #FF96A1;
  --color-primary-deep: #F4778A;
  --color-accent: #FFC28E;
  --color-blue: #9BC7DE;
  --color-red: #F56A6A;
  --color-success: #A8D8B9;
  --color-danger: #F2556D;
  --color-purple: #C3A6E1;
  --color-mint: #A8E0D0;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 36rpx;
  --shadow-card: 0 8rpx 24rpx rgba(244, 177, 177, 0.16);
  --shadow-soft: 0 4rpx 16rpx rgba(244, 177, 177, 0.12);
}
