  --color-surface: #FFFFFF;
  --color-text: #3A3A3A;
  --color-text-secondary: #8C8C8C;
  --color-border: #EDE7DF;
  --color-primary: #D98E8E;
  --color-accent: #E0A06E;
  --color-blue: #7FA3B8;
