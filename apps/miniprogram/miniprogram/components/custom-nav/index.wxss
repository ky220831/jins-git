.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(165deg, var(--grad-a), var(--grad-b));
}

.nav-inner {
  display: flex;
  align-items: center;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  margin-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--color-text);
  background: var(--color-surface);
  border-radius: 50%;
  box-shadow: var(--shadow-soft);
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  pointer-events: none;
}
