.nav-holder {
  background: linear-gradient(165deg, var(--grad-a), var(--grad-b));
  background-color: var(--color-bg);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(165deg, var(--grad-a), var(--grad-b));
  background-color: var(--color-bg);
  /* 防止机型渲染接缝白线 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.nav-inner {
  display: flex;
  align-items: center;
  position: relative;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: none;
}

.nav-chevron {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--color-text);
  border-bottom: 4rpx solid var(--color-text);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  pointer-events: none;
}
