.mc-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-card);
}

.mc-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mc-nav {
  width: 60rpx;
  height: 60rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: 50%;
}

.mc-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.mc-today {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: var(--color-primary-deep);
  background: #FFF0EC;
  border-radius: 999rpx;
}

.mc-error {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-danger);
}

.mc-week {
  display: flex;
  margin-top: 20rpx;
}

.mc-week-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.mc-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.mc-day {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.mc-day.today {
  background: #FFE9EC;
}

.mc-day.period {
  background: rgba(245, 106, 106, 0.14);
}

.mc-day.rest {
  background: rgba(155, 199, 222, 0.22);
}

.mc-day.selected {
  background: linear-gradient(135deg, #FFB3BB, #FF96A1);
  box-shadow: var(--shadow-soft);
}

.mc-day.selected .mc-day-num {
  color: #ffffff;
  font-weight: 700;
}

.mc-day.selected .mc-holiday {
  color: #ffffff;
}

.mc-day.selected .mc-dot {
  background: rgba(255, 255, 255, 0.85);
}

.mc-day.dim .mc-day-num {
  color: transparent;
}

.mc-day-num {
  font-size: 26rpx;
  color: var(--color-text);
}

.mc-holiday {
  font-size: 16rpx;
  line-height: 1.2;
  color: var(--color-red);
  max-width: 92rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mc-holiday.makeup {
  color: var(--color-blue);
}

.mc-dots {
  display: flex;
  gap: 6rpx;
  height: 10rpx;
  margin-top: 3rpx;
}

.mc-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.mc-dot.dot-todo {
  background: #CBB8AE;
}

.mc-dot.dot-event {
  background: #FFC28E;
}

.mc-legend {
  display: flex;
  gap: 20rpx;
  margin-top: 14rpx;
  padding: 10rpx 18rpx;
  background: var(--color-bg);
  border-radius: 999rpx;
}

.mc-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.mc-legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.mc-legend-dot.period {
  background: var(--color-red);
}

.mc-legend-dot.rest {
  background: var(--color-blue);
}

.mc-legend-dot.todo {
  background: #CBB8AE;
}

.mc-legend-dot.event {
  background: #FFC28E;
}

.mc-day-panel {
  margin-top: 24rpx;
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.mc-day-title {
  font-size: 28rpx;
  font-weight: 600;
}

.mc-status {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-red);
}

.mc-status.rest {
  color: var(--color-blue);
}

.mc-empty {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.mc-todo,
.mc-event {
  margin-top: 16rpx;
  padding: 18rpx;
  background: var(--color-surface);
  border-radius: 18rpx;
  box-shadow: var(--shadow-soft);
}

.mc-todo.done .mc-todo-title {
  color: var(--color-text-secondary);
  text-decoration: line-through;
}

.mc-todo-title,
.mc-event-title {
  font-size: 26rpx;
  color: var(--color-text);
}

.mc-todo-meta,
.mc-event-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.mc-more {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-primary-deep);
  padding: 14rpx 0;
  background: #FFF0EC;
  border-radius: 999rpx;
}
