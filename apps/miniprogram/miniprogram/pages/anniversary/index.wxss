.anniversary-page {
  padding-bottom: 64rpx;
}

.page-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
}

.page-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.error-text {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-danger);
}

.empty-list {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.anniversary-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 28rpx;
}

.anniversary-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.anniversary-name {
  font-size: 32rpx;
  font-weight: 600;
}

.count-badge {
  font-size: 24rpx;
  color: var(--color-red);
  background: #F8ECEC;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.anniversary-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.anniversary-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-bg);
  border-radius: 999rpx;
}

.chip.danger {
  color: var(--color-danger);
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.flex-btn {
  flex: 1;
  font-size: 28rpx;
}

.form {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.input {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
}
