.tip {
  font-size: 30rpx;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.input {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 32rpx;
}

.submit {
  margin-top: 32rpx;
}

.result {
  margin-top: 48rpx;
  align-items: center;
  text-align: center;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
}

.code {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--color-primary);
}

.result-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.go-home {
  margin-top: 32rpx;
}
