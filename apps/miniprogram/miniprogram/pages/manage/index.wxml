<view class="container {{themeClass}} manage-page">
  <image class="page-bg" src="{{themeBg}}" mode="aspectFill"></image>
  <custom-nav title="设置与数据" showBack="{{true}}" />

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <!-- 主管理 -->
  <block wx:if="{{isOwner}}">
    <view class="card">
      <view class="card-title-row">
        <text class="card-title">数据概览</text>
        <view class="role-badge">主管理</view>
      </view>
      <view class="count-grid">
        <view class="count-item"><view class="count-num">{{counts.todos}}</view><view class="count-label">待办</view></view>
        <view class="count-item"><view class="count-num">{{counts.mealTemplates}}</view><view class="count-label">菜单素材</view></view>
        <view class="count-item"><view class="count-num">{{counts.mealPlans}}</view><view class="count-label">今天吃什么</view></view>
        <view class="count-item"><view class="count-num">{{counts.restaurants}}</view><view class="count-label">餐厅</view></view>
        <view class="count-item"><view class="count-num">{{counts.restaurantVisits}}</view><view class="count-label">餐厅行程</view></view>
        <view class="count-item"><view class="count-num">{{counts.anniversaries}}</view><view class="count-label">纪念日</view></view>
        <view class="count-item"><view class="count-num">{{counts.trips}}</view><view class="count-label">旅行资料</view></view>
        <view class="count-item"><view class="count-num">{{counts.tripPlans}}</view><view class="count-label">旅行行程</view></view>
        <view class="count-item"><view class="count-num">{{counts.trash}}</view><view class="count-label">回收站</view></view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">数据导出（JSON + CSV）</view>
      <view class="manage-desc">导出全部业务数据：JSON 完整备份 + 各模块 CSV 表格 + 图片清单，链接 1 小时内有效，不会永久公开。</view>
      <view class="manage-result" wx:if="{{exportUrl}}">
        {{exportName}}（{{exportSizeLabel}}）
      </view>
      <view class="csv-list" wx:if="{{csvFiles.length}}">
        <view class="csv-row" wx:for="{{csvFiles}}" wx:key="name">
          <text class="csv-name">📄 {{item.name}}</text>
          <view class="link-btn" data-url="{{item.tempFileURL}}" bindtap="onCopyCsv">复制链接</view>
        </view>
      </view>
      <view class="manage-desc" wx:if="{{exportImages.length}}">🖼 图片清单 {{exportImages.length}} 项已包含在 JSON 文件中（cloud:// 地址）</view>
      <view class="btn-row">
        <button class="btn-primary flex-btn" bindtap="onExport" loading="{{exporting}}" disabled="{{exporting}}">导出数据</button>
        <button class="btn-secondary flex-btn" wx:if="{{exportUrl}}" bindtap="onCopyExportUrl">复制链接</button>
      </view>
    </view>

    <view class="card">
      <view class="card-title">操作记录（最近 50 条）</view>
      <view class="empty" wx:if="{{!auditLogs.length}}">暂无操作记录</view>
      <view class="audit-row" wx:for="{{auditLogs}}" wx:key="id">
        <view class="audit-avatar av-{{item.module}}">{{item.icon}}</view>
        <view class="audit-body">
        <view class="audit-title">{{item.actionLabel}}</view>
          <view class="audit-meta">{{item.timeLabel}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">回收站（72 小时内可恢复）</view>
      <picker range="{{collectionOptions}}" range-key="label" value="{{trashFilterIndex}}" bindchange="onTrashFilterChange">
        <view class="picker-value">筛选：{{trashFilterLabel}}</view>
      </picker>
      <view class="empty" wx:if="{{!trash.length}}">回收站是空的</view>
      <view class="trash-row" wx:for="{{trash}}" wx:key="id">
        <view class="trash-check {{item.selected ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onToggleSelect">{{item.selected ? '✓' : ''}}</view>
        <view class="trash-body">
          <view class="trash-title">{{item.collectionLabel}} · {{item.title}}</view>
          <view class="trash-meta">删除于 {{item.deletedLabel}} · 将于 {{item.purgeLabel}} 永久删除</view>
          <view class="trash-meta">{{item.deleteReason === 'auto_expire' ? '自动清理' : '手动删除'}} · {{item.retentionType === 'temporary' ? '临时数据' : '永久数据'}}</view>
        </view>
        <view class="trash-actions">
          <view class="link-btn" data-id="{{item.id}}" bindtap="onRestoreOne">恢复</view>
          <view class="link-btn danger" data-id="{{item.id}}" bindtap="onPurgeOne">删除</view>
        </view>
      </view>
      <view class="btn-row" wx:if="{{trash.length}}">
        <button class="btn-secondary flex-btn" bindtap="onSelectAll">全选/取消</button>
        <button class="btn-secondary flex-btn" bindtap="onBatchRestore">批量恢复</button>
        <button class="btn-secondary flex-btn danger-btn" bindtap="onBatchPurge">批量删除</button>
      </view>
      <button class="btn-secondary danger-btn purge-all-btn" wx:if="{{trash.length}}" bindtap="onPurgeAll">清空回收站（{{trash.length}}）</button>
    </view>

    <view class="card">
      <view class="card-title">家庭管理</view>
      <view class="member" wx:for="{{members}}" wx:key="userId">
        <view class="member-left">
          <view class="member-avatar">{{item.role === 'owner' ? '👑' : '💗'}}</view>
          <view class="member-info">
            <view class="member-role">{{item.nickname || item.roleLabel}}</view>
            <view class="member-id">ID {{item.userId}} · {{item.roleLabel}}</view>
          </view>
        </view>
      </view>
      <view class="invite-box" wx:if="{{inviteCode}}">
        <view class="invite-code" bindtap="onCopyInvite">{{inviteCode}}</view>
        <view class="invite-meta">有效期至 {{inviteExpiresAt}} · 点击复制</view>
        <button class="btn-secondary regen-btn" bindtap="onRegenInvite">重新生成邀请码</button>
      </view>
      <view class="bound" wx:if="{{!inviteCode}}">双人已绑定 ✅</view>
    </view>

    <view class="card">
      <view class="card-title">业务管理入口</view>
      <view class="btn-row">
        <button class="btn-secondary flex-btn" bindtap="onOpenMeal">今天吃什么</button>
        <button class="btn-secondary flex-btn" bindtap="onOpenRestaurant">下馆子</button>
      </view>
      <view class="btn-row">
        <button class="btn-secondary flex-btn" bindtap="onOpenAnniversary">纪念日</button>
        <button class="btn-secondary flex-btn" bindtap="onOpenTravel">旅行</button>
      </view>
    </view>
  </block>

  <!-- 副管理 -->
  <block wx:else>
    <view class="card">
      <view class="card-title-row">
        <text class="card-title">收起今天的菜单</text>
        <view class="role-badge">副管理</view>
      </view>
      <view class="empty" wx:if="{{!mealPlans.length}}">今天没有已加上的菜单</view>
      <view class="plan-row" wx:for="{{mealPlans}}" wx:key="id">
        <view class="plan-left">
          <view class="plan-name">🍚 {{item.name}}</view>
          <view class="plan-meta">{{item.date}}{{item.time ? ' ' + item.time : ''}}</view>
        </view>
        <view class="plan-actions">
          <view class="link-btn" data-id="{{item.id}}" bindtap="onOfflineMeal">收起</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">收起下馆子的餐厅</view>
      <view class="empty" wx:if="{{!restaurants.length}}">还没有收藏的餐厅</view>
      <view class="plan-row" wx:for="{{restaurants}}" wx:key="id">
        <view class="plan-left">
          <view class="plan-name">🍴 {{item.name}}</view>
          <view class="plan-meta">{{item.category || '未分类'}}</view>
        </view>
        <view class="plan-actions">
          <view class="link-btn" data-id="{{item.id}}" bindtap="onOfflineRestaurant">收起</view>
        </view>
      </view>
    </view>
  </block>
</view>
