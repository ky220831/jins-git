.period-page {
  padding-bottom: 80rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.error-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-danger);
  text-align: center;
}

.card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin: 16rpx 0 8rpx;
}

.ongoing-line {
  font-size: 26rpx;
  color: #D9534F;
  background: rgba(217, 83, 79, 0.08);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.picker-value {
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.form-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.save-btn {
  margin-top: 24rpx;
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toggle-label {
  font-size: 26rpx;
  color: var(--color-text);
}

.period-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.period-row:last-child {
  border-bottom: none;
}

.period-range {
  font-size: 28rpx;
  color: var(--color-text);
}

.period-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.period-delete {
  font-size: 26rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}

.period-actions {
  display: flex;
  gap: 8rpx;
}

.period-edit {
  font-size: 26rpx;
  color: var(--color-primary-deep);
  padding: 8rpx 16rpx;
}

.period-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
