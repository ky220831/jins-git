<view class="container calendar-page">
  <!-- 顶部：双人爱心连接 + 右上角小邀请码 -->
  <view class="top-bar">
    <view class="couple">
      <view class="mini-avatar me" bindtap="onStartEditName">
        <text class="mini-emoji">{{isOwner ? '👑' : '💗'}}</text>
        <text class="mini-name">{{myDisplayName}}</text>
      </view>
      <view class="heart">❤️</view>
      <view class="mini-avatar">
        <text class="mini-emoji">{{isOwner ? '💗' : '👑'}}</text>
        <text class="mini-name">{{partnerDisplayName}}</text>
      </view>
    </view>
    <view class="invite-badge" wx:if="{{isOwner && inviteCode}}" bindtap="onCopyInvite">🔑 {{inviteCode}}</view>
    <view class="invite-badge bound" wx:if="{{!inviteCode}}">💗</view>
  </view>

  <view class="cal-header">
    <view class="cal-nav" bindtap="onPrev">‹</view>
    <view class="cal-title">{{year}}年{{month}}月</view>
    <view class="cal-nav" bindtap="onNext">›</view>
    <view class="cal-today" bindtap="onToday">今天</view>
  </view>

  <view class="week-row">
    <view class="week-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="grid">
    <view
      class="day-cell {{item.inMonth ? '' : 'dim'}} {{item.isToday ? 'today' : ''}} {{item.key === selectedDate ? 'selected' : ''}} {{item.isWeekend ? 'weekend' : ''}} {{item.periodState === 'ongoing' ? 'period-ongoing' : ''}} {{item.periodState === 'past' ? 'period-past' : ''}} {{item.periodState === 'predicted' ? 'period-predicted' : ''}} {{item.periodState === 'rest' ? 'rest' : ''}}"
      wx:for="{{days}}"
      wx:key="uid"
      data-key="{{item.key}}"
      bindtap="onTapDay"
    >
      <view class="day-num">{{item.day ? item.day : ''}}</view>
      <view
        class="holiday-label {{item.holidayKind === 'makeup_workday' ? 'makeup' : ''}} {{item.holidayKind === 'weekend' ? 'weekend-badge' : ''}}"
        wx:if="{{item.holidayLabel}}"
      >{{item.holidayLabel}}</view>
      <view class="dots">
        <view class="dot {{item.periodState === 'ongoing' ? 'dot-period-ongoing' : ''}} {{item.periodState === 'past' ? 'dot-period-past' : ''}} {{item.periodState === 'predicted' ? 'dot-period-predicted' : ''}} {{item.periodState === 'rest' ? 'dot-rest' : ''}}" wx:if="{{item.periodState}}"></view>
        <view class="dot dot-todo" wx:if="{{item.hasTodo}}"></view>
        <view class="dot dot-event" wx:if="{{item.hasEvent}}"></view>
      </view>
      <view class="event-count" wx:if="{{item.eventCount > 1}}">{{item.eventCount}}</view>
    </view>
  </view>

  <view class="legend">
    <view class="legend-item"><view class="legend-dot period-ongoing"></view>生理期进行中</view>
    <view class="legend-item"><view class="legend-dot period-predicted"></view>生理期预计</view>
    <view class="legend-item"><view class="legend-dot period-past"></view>生理期已过</view>
    <view class="legend-item"><view class="legend-dot rest"></view>🔵 休息</view>
    <view class="legend-item"><view class="legend-dot weekend"></view>周末</view>
    <view class="legend-item"><view class="legend-dot makeup"></view>调休</view>
    <view class="legend-item"><view class="legend-dot todo"></view>To Do</view>
    <view class="legend-item"><view class="legend-dot event"></view>日程</view>
  </view>

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <view class="day-panel" wx:if="{{selectedDate}}">
    <view class="day-title">{{selectedDate}}</view>
    <view class="mark-chips">
      <view class="mark-chip {{item.kind === 'makeup_workday' ? 'makeup' : ''}} {{item.kind === 'weekend' ? 'weekend' : ''}}" wx:for="{{dayMarks}}" wx:key="label">{{item.label}}</view>
    </view>
    <view class="status-line period-ongoing" wx:if="{{dayPeriodState === 'ongoing'}}">🔴 生理期（进行中）</view>
    <view class="status-line period-predicted" wx:if="{{dayPeriodState === 'predicted'}}">🌸 生理期（预计）</view>
    <view class="status-line period-past" wx:if="{{dayPeriodState === 'past'}}">🩷 生理期（已过去）</view>
    <view class="status-line rest" wx:if="{{dayPeriodState === 'rest'}}">🔵 休息日</view>
    <view class="day-empty" wx:if="{{!dayTodos.length && !dayEvents.length && !dayPeriodState && !dayMarks.length}}">🌷 这一天还没有安排</view>

    <!-- 快速入口：日历 → 核心功能新增/编辑（自动带入当天日期） -->
    <view class="quick-row">
      <view class="quick-btn" bindtap="onShowForm">＋ 事项</view>
      <view class="quick-btn" bindtap="onQuickPeriod">🌸 生理期</view>
      <view class="quick-btn" bindtap="onQuickMeal">🍚 菜单</view>
      <view class="quick-btn" bindtap="onQuickRestaurant">🍴 行程</view>
      <view class="quick-btn" bindtap="onQuickTravel">✈️ 旅游</view>
      <view class="quick-btn" bindtap="onQuickAnniversary">❤️ 纪念日</view>
    </view>

    <view
      class="todo-item {{item.status === 'completed' ? 'done' : ''}}"
      wx:for="{{dayTodos}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-status="{{item.status}}"
      bindtap="onToggleTodo"
    >
      <view class="todo-title">{{item.title}}</view>
      <view class="todo-meta">{{item.timeLabel}} · {{item.priorityLabel}}</view>
    </view>

    <view class="event-item" wx:for="{{dayEvents}}" wx:key="id" data-type="{{item.sourceType}}" data-id="{{item.sourceId}}" bindtap="onTapEvent">
      <view class="event-title">{{item.title}}</view>
      <view class="event-meta">{{item.timeLabel}}</view>
    </view>

  </view>

  <!-- 昵称编辑 -->
  <view class="name-edit" wx:if="{{showNameEdit}}">
    <view class="name-edit-title">改我的昵称</view>
    <input class="input" placeholder="输入昵称（最多 16 字）" value="{{nameInput}}" bindinput="onNameInput" maxlength="16" />
    <view class="name-edit-actions">
      <button class="btn-secondary name-edit-btn" bindtap="onHideNameEdit">取消</button>
      <button class="btn-primary name-edit-btn" bindtap="onSaveName" loading="{{savingName}}" disabled="{{savingName}}">保存</button>
    </view>
  </view>

  <view class="form" wx:if="{{showForm}}">
    <view class="form-title">添加事项（{{selectedDate}}）</view>
    <input class="input" placeholder="事项标题" value="{{formTitle}}" bindinput="onTitleInput" maxlength="100" />
    <picker mode="time" value="{{formTime}}" bindchange="onTimeChange">
      <view class="picker-value {{formTime ? '' : 'placeholder'}}">{{formTime || '时间（可选，点这里选）'}}</view>
    </picker>
    <input class="input" placeholder="备注（可选）" value="{{formNote}}" bindinput="onNoteInput" maxlength="200" />
    <view class="form-actions">
      <button class="btn-secondary form-btn" bindtap="onHideForm">取消</button>
      <button class="btn-primary form-btn" bindtap="onAddTodo" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>
  </view>

</view>
