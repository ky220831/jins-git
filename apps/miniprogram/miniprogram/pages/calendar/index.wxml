<view class="container {{themeClass}} calendar-page">
  <custom-nav title="日历" />
  <!-- 顶部：双人爱心连接 + 右上角小邀请码 -->
  <view class="top-bar" wx:if="{{guestMode}}">
    <view class="guest-badge">🌿 体验模式</view>
    <view class="guest-actions">
      <view class="guest-btn primary" bindtap="onGuestCreate">创建空间</view>
      <view class="guest-btn" bindtap="onGuestJoin">加入空间</view>
    </view>
  </view>
  <view class="top-bar" wx:else>
    <view class="couple">
        <view class="mini-avatar me" bindtap="onStartEditName">
          <text class="mini-emoji">{{isOwner ? '👑' : '💗'}}</text>
          <text class="mini-name {{myNameLong ? 'long' : ''}}">{{myDisplayName}}</text>
          <view class="edit-badge" catchtap="onStartEditName">✏️</view>
        </view>
      <view class="heart">❤️</view>
      <view class="mini-avatar">
          <text class="mini-emoji">{{isOwner ? '💗' : '👑'}}</text>
          <text class="mini-name {{partnerNameLong ? 'long' : ''}}">{{partnerDisplayName}}</text>
      </view>
    </view>
    <view class="invite-badge" wx:if="{{isOwner && inviteCode}}" bindtap="onCopyInvite">🔑 {{inviteCode}}</view>
    <view class="invite-badge bound" wx:if="{{!inviteCode}}">💗</view>
  </view>

  <view class="guest-error" wx:if="{{guestMode && guestError}}" bindtap="onRetry">⚠️ 网络异常，节假日可能未加载 · 点此重试</view>

  <view class="cal-header">
    <view class="view-switch">
      <view class="view-item {{viewMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="onSwitchView">月</view>
      <view class="view-item {{viewMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="onSwitchView">周</view>
      <view class="view-item {{viewMode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="onSwitchView">年</view>
    </view>
    <view class="cal-pill">
      <view class="cal-nav" bindtap="onPrev">‹</view>
      <picker wx:if="{{viewMode !== 'year'}}" class="cal-picker" mode="date" fields="month" value="{{pickerDate}}" bindchange="onMonthPick">
        <view class="cal-title">{{year}}年{{month}}月</view>
      </picker>
      <picker wx:else class="cal-picker" mode="date" fields="year" value="{{yearPickerDate}}" bindchange="onYearPick">
        <view class="cal-title">{{year}}年</view>
      </picker>
      <view class="cal-nav" bindtap="onNext">›</view>
    </view>
    <view class="cal-today" bindtap="onToday">今天</view>
  </view>

  <block wx:if="{{viewMode === 'month'}}">
    <view class="week-row">
      <view class="week-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="grid">
      <view
        class="day-cell {{item.inMonth ? '' : 'dim'}} {{item.isToday ? 'today' : ''}} {{item.key === selectedDate ? 'selected' : ''}} {{item.isWeekend ? 'weekend' : ''}} {{item.periodState === 'ongoing' ? 'period-ongoing' : ''}} {{item.periodState === 'past' ? 'period-past' : ''}} {{item.periodState === 'predicted' ? 'period-predicted' : ''}} {{item.periodState === 'rest' ? 'rest' : ''}}"
        wx:for="{{days}}"
        wx:key="uid"
        data-key="{{item.key}}"
        bindtap="onTapDay"
      >
        <view class="day-num">{{item.day ? item.day : ''}}</view>
        <view class="cell-label label-{{item.cellKind}}" wx:if="{{item.cellLabel}}">{{item.cellLabel}}</view>
        <view class="dots">
          <view class="dot {{item.periodState === 'ongoing' ? 'dot-period-ongoing' : ''}} {{item.periodState === 'past' ? 'dot-period-past' : ''}} {{item.periodState === 'predicted' ? 'dot-period-predicted' : ''}} {{item.periodState === 'rest' ? 'dot-rest' : ''}}" wx:if="{{item.periodState}}"></view>
          <view class="dot dot-todo" wx:if="{{item.hasTodo}}"></view>
          <view class="dot {{d}}" wx:for="{{item.eventDotList}}" wx:for-item="d" wx:key="*this"></view>
        </view>
        <view class="event-count" wx:if="{{item.eventCount > 4}}">{{item.eventCount}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'week'}}">
    <view class="week-row">
      <view class="week-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="week-grid">
      <view
        class="day-cell {{item.inMonth ? '' : 'dim'}} {{item.isToday ? 'today' : ''}} {{item.key === selectedDate ? 'selected' : ''}} {{item.isWeekend ? 'weekend' : ''}} {{item.periodState === 'ongoing' ? 'period-ongoing' : ''}} {{item.periodState === 'past' ? 'period-past' : ''}} {{item.periodState === 'predicted' ? 'period-predicted' : ''}} {{item.periodState === 'rest' ? 'rest' : ''}}"
        wx:for="{{weekDays}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTapDay"
      >
        <view class="day-num">{{item.day}}</view>
        <view class="cell-label label-{{item.cellKind}}" wx:if="{{item.cellLabel}}">{{item.cellLabel}}</view>
        <view class="dots">
          <view class="dot {{item.periodState === 'ongoing' ? 'dot-period-ongoing' : ''}} {{item.periodState === 'past' ? 'dot-period-past' : ''}} {{item.periodState === 'predicted' ? 'dot-period-predicted' : ''}} {{item.periodState === 'rest' ? 'dot-rest' : ''}}" wx:if="{{item.periodState}}"></view>
          <view class="dot dot-todo" wx:if="{{item.hasTodo}}"></view>
          <view class="dot {{d}}" wx:for="{{item.eventDotList}}" wx:for-item="d" wx:key="*this"></view>
        </view>
        <view class="event-count" wx:if="{{item.eventCount > 4}}">{{item.eventCount}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'year'}}">
    <view class="year-grid">
      <view class="month-card {{month === item.month ? 'active' : ''}}" wx:for="{{yearMonths}}" wx:key="month" data-month="{{item.month}}" bindtap="onTapMonth">
        <view class="month-num">{{item.month}}月</view>
        <view class="month-days">{{item.daysInMonth}} 天</view>
      </view>
    </view>
    <view class="year-hint">点击月份进入月视图</view>
  </block>

  <view class="legend-card guest-tip" wx:if="{{guestMode}}">
    <view class="legend-head">
      <text class="legend-title">🌿 体验模式</text>
    </view>
    <view class="guest-tip-text">这里展示公共日历（节假日 / 调休 / 周末 / 农历 / 节气）。创建或加入空间后，才能看到并记录你们两个人的日程、纪念日、生理期等；所有私人数据仅对绑定双方可见。</view>
  </view>
  <view class="legend-card" wx:else>
    <view class="legend-head" bindtap="onToggleLegend">
      <text class="legend-title">图例</text>
      <text class="legend-arrow">{{legendOpen ? '收起 ▴' : '展开 ▾'}}</text>
    </view>
    <view class="legend-grid" wx:if="{{legendOpen}}">
      <view class="legend-chip"><view class="legend-dot period-ongoing"></view><text>生理期进行中</text></view>
      <view class="legend-chip"><view class="legend-dot period-predicted"></view><text>生理期预计</text></view>
      <view class="legend-chip"><view class="legend-dot period-past"></view><text>生理期已过</text></view>
      <view class="legend-chip"><view class="legend-dot todo"></view><text>待办</text></view>
      <view class="legend-chip"><view class="legend-dot meal"></view><text>菜单</text></view>
      <view class="legend-chip"><view class="legend-dot restaurant"></view><text>餐厅</text></view>
      <view class="legend-chip"><view class="legend-dot anniversary"></view><text>纪念日</text></view>
      <view class="legend-chip"><view class="legend-dot trip"></view><text>旅行</text></view>
    </view>
  </view>

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <view class="day-panel" wx:if="{{selectedDate && viewMode !== 'year'}}">
    <view class="day-title">{{selectedDate}}</view>
    <view class="mark-chips">
      <view class="mark-chip {{item.kind === 'makeup_workday' ? 'makeup' : ''}} {{item.kind === 'weekend' ? 'weekend' : ''}}" wx:for="{{dayMarks}}" wx:key="label">{{item.label}}</view>
    </view>
    <view class="status-line period-ongoing" wx:if="{{dayPeriodState === 'ongoing'}}">🔴 生理期（进行中）</view>
    <view class="status-line period-predicted" wx:if="{{dayPeriodState === 'predicted'}}">🌸 生理期（预计）</view>
    <view class="status-line period-past" wx:if="{{dayPeriodState === 'past'}}">🩷 生理期（已过去）</view>
    <view class="status-line rest" wx:if="{{dayPeriodState === 'rest'}}">🔵 休息日</view>
    <view class="day-empty" wx:if="{{guestMode}}">创建空间后，这里会记录你们的一天</view>
    <view class="day-empty" wx:elif="{{loading}}">正在加载这一天…</view>
    <view class="day-empty" wx:elif="{{!dayTodos.length && !dayEvents.length && !dayPeriodState && !dayMarks.length}}">
      <view class="empty-icon">🌷</view>
      <view>这一天还没有安排，点下方按钮快速添加</view>
    </view>

    <!-- 快速入口：日历 → 核心功能新增/编辑（自动带入当天日期） -->
    <view class="quick-row">
      <view class="quick-btn" bindtap="onShowForm">＋ 事项</view>
      <view class="quick-btn" bindtap="onQuickPeriod">🌸 生理期</view>
      <view class="quick-btn" bindtap="onQuickMeal">🍚 吃什么</view>
      <view class="quick-btn" bindtap="onQuickRestaurant">🍴 下馆子</view>
      <view class="quick-btn" bindtap="onQuickTravel">✈️ 旅行</view>
      <view class="quick-btn" bindtap="onQuickAnniversary">❤️ 纪念日</view>
    </view>

    <view
      class="todo-item cat-{{item.businessType || 'todo'}} {{item.status === 'completed' ? 'done' : ''}}"
      wx:for="{{dayTodos}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-status="{{item.status}}"
      bindtap="onToggleTodo"
    >
      <view class="cat-bar"></view>
      <view class="item-icon">{{item.icon}}</view>
      <view class="item-body">
        <view class="todo-title">{{item.title}}</view>
        <view class="todo-meta">{{item.moduleLabel}} · {{item.timeLabel}} · {{item.priorityLabel}}</view>
      </view>
    </view>

    <view class="event-item cat-{{item.sourceType || 'custom'}}" wx:for="{{dayEvents}}" wx:key="id" data-type="{{item.sourceType}}" data-id="{{item.sourceId}}" bindtap="onTapEvent">
      <view class="cat-bar"></view>
      <view class="item-icon">{{item.icon}}</view>
      <view class="item-body">
        <view class="event-title">{{item.title}}</view>
        <view class="event-meta">{{item.moduleLabel}} · {{item.timeLabel}}</view>
      </view>
    </view>

  </view>

  <!-- 昵称编辑（底部弹窗） -->
  <view class="modal" wx:if="{{showNameEdit}}">
    <view class="mask" bindtap="onHideNameEdit"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">改我的昵称</view>
      <view class="field-label">昵称（最多 16 字）</view>
      <textarea class="input textarea auto-grow" placeholder="最多 16 字" value="{{nameInput}}" bindinput="onNameInput" maxlength="16" auto-height />
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideNameEdit">取消</button>
        <button class="btn-primary form-btn" bindtap="onSaveName" loading="{{savingName}}" disabled="{{savingName}}">保存</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showForm}}">
    <view class="mask" bindtap="onHideForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">添加事项（{{selectedDate}}）</view>
      <view class="field-label">事项标题</view>
      <textarea class="input textarea auto-grow" placeholder="事项标题" value="{{formTitle}}" bindinput="onTitleInput" maxlength="100" auto-height />
      <view class="field-label">时间（可选）</view>
      <picker mode="time" value="{{formTime}}" bindchange="onTimeChange">
        <view class="picker-value {{formTime ? '' : 'placeholder'}}">{{formTime || '时间（可选，点这里选）'}}</view>
      </picker>
      <view class="field-label">备注（可选）</view>
      <textarea class="input textarea auto-grow" placeholder="备注（可选）" value="{{formNote}}" bindinput="onNoteInput" maxlength="200" auto-height />
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onAddTodo" loading="{{saving}}" disabled="{{saving}}">保存</button>
      </view>
    </view>
  </view>

</view>
