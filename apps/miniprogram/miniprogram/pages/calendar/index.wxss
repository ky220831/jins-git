.calendar-page {
  padding-bottom: 64rpx;
}

.cal-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border-radius: 50%;
  box-shadow: var(--shadow-soft);
}

.cal-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.cal-today {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary-deep);
  background: var(--color-surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow-soft);
}

.cal-options {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.period-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toggle-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.week-row {
  display: flex;
  margin-top: 24rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.day-cell {
  width: 14.28%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.day-cell.today {
  background: #FFE9EC;
}

.day-cell.period {
  background: rgba(245, 106, 106, 0.14);
}

.day-cell.rest {
  background: rgba(155, 199, 222, 0.22);
}

.day-cell.selected {
  background: linear-gradient(135deg, #FFB3BB, #FF96A1);
  box-shadow: var(--shadow-soft);
}

.day-cell.selected .day-num {
  color: #ffffff;
  font-weight: 700;
}

.day-cell.selected .holiday-label {
  color: #ffffff;
}

.day-cell.selected .dot {
  background: rgba(255, 255, 255, 0.85);
}

.day-cell.dim .day-num {
  color: transparent;
}

.day-num {
  font-size: 28rpx;
  color: var(--color-text);
}

.holiday-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-red);
  max-width: 96rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.holiday-label.makeup {
  color: var(--color-blue);
}

.dots {
  display: flex;
  gap: 6rpx;
  height: 12rpx;
  margin-top: 4rpx;
}

.dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}

.dot-todo {
  background: #CBB8AE;
}

.dot-event {
  background: #FFC28E;
}

.legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow-soft);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot.period {
  background: var(--color-red);
}

.legend-dot.rest {
  background: var(--color-blue);
}

.legend-dot.todo {
  background: var(--color-text-secondary);
}

.legend-dot.event {
  background: var(--color-accent);
}

.error-text {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-danger);
}

.day-panel {
  margin-top: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.day-title {
  font-size: 30rpx;
  font-weight: 600;
}

.status-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-red);
}

.status-line.rest {
  color: var(--color-blue);
}

.day-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.todo-item,
.event-item {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF9F4;
  border-radius: 20rpx;
  border: 2rpx solid #FBE9DC;
}

.todo-item.done .todo-title {
  color: var(--color-text-secondary);
  text-decoration: line-through;
}

.todo-title,
.event-title {
  font-size: 28rpx;
  color: var(--color-text);
}

.todo-meta,
.event-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.add-btn {
  margin-top: 28rpx;
}

.form {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.form-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input {
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
}

.period-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.period-card-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.period-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.period-row:last-child {
  border-bottom: none;
}

.period-range {
  font-size: 28rpx;
  color: var(--color-text);
}

.period-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.period-delete {
  font-size: 26rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}

.period-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
