.calendar-page {
  padding-bottom: 64rpx;
}

.cal-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border-radius: 50%;
  box-shadow: var(--shadow-soft);
}

.cal-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.cal-today {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary-deep);
  background: var(--color-surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow-soft);
}

.cal-options {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.period-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toggle-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.week-row {
  display: flex;
  margin-top: 14rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.day-cell {
  width: 14.28%;
  height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.day-cell.today {
  background: #FFE9EC;
}

.day-cell.period {
  background: rgba(245, 106, 106, 0.14);
}

.day-cell.rest {
  background: rgba(155, 199, 222, 0.22);
}

.day-cell.selected {
  background: linear-gradient(135deg, #FFB3BB, #FF96A1);
  box-shadow: var(--shadow-soft);
}

.day-cell.selected .day-num {
  color: #ffffff;
  font-weight: 700;
}

.day-cell.selected .holiday-label {
  color: #ffffff;
}

.day-cell.selected .dot {
  background: rgba(255, 255, 255, 0.85);
}

.day-cell.dim .day-num {
  color: transparent;
}

.day-num {
  font-size: 28rpx;
  color: var(--color-text);
}

.holiday-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-red);
  max-width: 96rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.holiday-label.makeup {
  color: var(--color-blue);
}

.dots {
  display: flex;
  gap: 6rpx;
  height: 12rpx;
  margin-top: 4rpx;
}

.dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}

.dot-todo {
  background: #CBB8AE;
}

.dot-event {
  background: #FFC28E;
}

.legend-card {
  margin-top: 14rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow-soft);
}

.legend-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.legend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot.period {
  background: var(--color-red);
}

.legend-dot.rest {
  background: var(--color-blue);
}

.legend-dot.todo {
  background: var(--color-text-secondary);
}

.legend-dot.event {
  background: var(--color-accent);
}

.error-text {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-danger);
}

.day-panel {
  margin-top: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.day-title {
  font-size: 30rpx;
  font-weight: 600;
}

.status-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-red);
}

.status-line.rest {
  color: var(--color-blue);
}

.day-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.todo-item,
.event-item {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF9F4;
  border-radius: 20rpx;
  border: 2rpx solid #FBE9DC;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.todo-item.done .todo-title {
  color: var(--color-text-secondary);
  text-decoration: line-through;
}

.todo-title,
.event-title {
  font-size: 28rpx;
  color: var(--color-text);
}

.todo-meta,
.event-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.item-icon {
  font-size: 34rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.add-btn {
  margin-top: 28rpx;
}

.form {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.form-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input {
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
}

.period-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.period-card-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.period-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.period-row:last-child {
  border-bottom: none;
}

.period-range {
  font-size: 28rpx;
  color: var(--color-text);
}

.period-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.period-delete {
  font-size: 26rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}

.period-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---- 顶部：双人爱心 + 邀请码（1.0.3 UI 优化） ---- */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.couple {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 18rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
}

.mini-avatar.me {
  background: #FFE9EC;
}

.mini-emoji {
  font-size: 30rpx;
}

.mini-name {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text);
  max-width: 130rpx;
  overflow: hidden;
  white-space: nowrap;
}

/* 昵称过长时用“弹幕滚轮”效果完整展示（1.0.12） */
.mini-name.long {
  display: inline-block;
  padding-left: 24rpx;
  animation: name-marquee 8s linear infinite;
}

@keyframes name-marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}

.heart {
  font-size: 32rpx;
}

.invite-badge {
  padding: 8rpx 16rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--color-primary-deep);
  font-weight: 600;
  box-shadow: var(--shadow-soft);
}

.invite-badge.bound {
  font-size: 28rpx;
}

/* ---- 格子：周末 / 生理期三态 ---- */
.day-cell.weekend {
  background: rgba(226, 221, 246, 0.35);
}

.day-cell.period-ongoing {
  background: rgba(217, 83, 79, 0.18);
}

.day-cell.period-predicted {
  background: rgba(249, 195, 205, 0.30);
}

.day-cell.period-past {
  background: rgba(233, 214, 216, 0.40);
}

/* 选中/今天 优先级最高，避免被状态色覆盖 */
.day-cell.selected {
  background: linear-gradient(135deg, #FFB3BB, #FF96A1);
}

.day-cell.today:not(.selected) {
  background: #FFE9EC;
}

/* ---- 标识徽章 ---- */
.holiday-label {
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(214, 82, 82, 0.10);
  color: var(--color-red);
  font-weight: 600;
}

.holiday-label.makeup {
  background: rgba(235, 146, 89, 0.16);
  color: #D97B2B;
}

.holiday-label.weekend-badge {
  background: rgba(150, 141, 170, 0.12);
  color: #8A8198;
}

.day-cell.selected .holiday-label {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

/* ---- 事件数量角标 ---- */
.event-count {
  position: absolute;
  top: 6rpx;
  right: 14rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #ffffff;
  background: var(--color-accent);
  border-radius: 999rpx;
  padding: 0 6rpx;
}

.day-cell {
  position: relative;
}

/* ---- 图例 ---- */
.legend-dot.period-ongoing {
  background: #D9534F;
}

.legend-dot.period-predicted {
  background: #F3A8B5;
}

.legend-dot.period-past {
  background: #DDB8BC;
}

.legend-dot.weekend {
  background: #A79FC4;
}

.legend-dot.makeup {
  background: #E8935A;
}

/* ---- 当天详情：标识 chips + 状态行 ---- */
.mark-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mark-chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-red);
  background: rgba(214, 82, 82, 0.10);
}

.mark-chip.makeup {
  color: #D97B2B;
  background: rgba(235, 146, 89, 0.16);
}

.mark-chip.weekend {
  color: #8A8198;
  background: rgba(150, 141, 170, 0.12);
}

.status-line.period-ongoing {
  color: #D9534F;
}

.status-line.period-predicted {
  color: #D97A8E;
}

.status-line.period-past {
  color: #B98F94;
}

/* ---- 快速入口 ---- */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.quick-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary-deep);
  background: #FFF1EF;
  border-radius: 999rpx;
  border: 2rpx solid #F7D9D5;
}

.quick-btn:active {
  background: #FFE3DF;
}

/* ---- 昵称编辑 ---- */
.name-edit {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.name-edit-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.name-edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.name-edit-btn {
  flex: 1;
  font-size: 28rpx;
}

/* ---- 日期/时间表盘选择 ---- */
.picker-value {
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.picker-value.placeholder {
  color: var(--color-text-secondary);
}
