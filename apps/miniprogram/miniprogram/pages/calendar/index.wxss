.calendar-page {
  padding-bottom: 64rpx;
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.cal-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-soft);
  padding: 6rpx 12rpx;
}

.cal-nav {
  width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-text-secondary);
}

.cal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: var(--color-text);
  min-width: 160rpx;
}

.cal-today {
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: var(--color-primary-deep);
  background: rgba(240, 138, 155, 0.10);
  border-radius: var(--radius-pill);
  font-weight: 600;
}

.cal-options {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.period-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toggle-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.week-row {
  display: flex;
  margin-top: 14rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.day-cell {
  width: calc((100% - 72rpx) / 7);
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  padding-top: 10rpx;
  box-sizing: border-box;
  position: relative;
}

.day-cell.today {
  background: var(--color-surface);
  box-shadow: inset 0 0 0 2rpx rgba(240, 138, 155, 0.55), var(--shadow-soft);
}

.day-cell.period {
  background: var(--tag-period);
}

.day-cell.rest {
  background: var(--tag-rest);
}

.day-cell.selected {
  background: rgba(240, 138, 155, 0.10);
  box-shadow: inset 0 0 0 2rpx rgba(240, 138, 155, 0.75), var(--shadow-soft);
}

.day-cell.selected .day-num {
  color: var(--color-primary-deep);
  font-weight: 600;
}

.day-cell.dim .day-num {
  color: transparent;
}

.day-num {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.2;
}

.day-cell.dim {
  background: transparent;
  box-shadow: none;
}

.day-cell.weekend .day-num {
  color: #A79FC4;
}

/* 次级标签：法定节假日/调休/周末 > 节气 > 农历（≤20rpx，克制显示） */
.cell-label {
  font-size: 20rpx;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 1rpx 8rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-weight: 400;
}

.label-holiday {
  background: rgba(217, 110, 128, 0.12);
  color: var(--color-period);
  font-weight: 500;
}

.label-makeup {
  background: rgba(224, 162, 107, 0.16);
  color: #C97F3E;
  font-weight: 500;
}

.label-weekend {
  background: rgba(167, 159, 196, 0.12);
  color: #8A8198;
}

.label-term {
  color: var(--color-primary-deep);
}

.dots {
  display: flex;
  gap: 6rpx;
  height: 10rpx;
  margin-top: auto;
  margin-bottom: 8rpx;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 分类圆点：同色系固定语义色（V2） */
.dot-todo { background: var(--color-todo); }
.dot-meal { background: var(--color-meal); }
.dot-restaurant { background: var(--color-restaurant); }
.dot-anniversary { background: var(--color-anniversary); }
.dot-trip { background: var(--color-travel); }
.dot-period { background: var(--color-period); }
.dot-custom { background: var(--color-todo); }
.dot-period-ongoing { background: var(--color-period); }
.dot-period-predicted { background: #F3A8B5; }
.dot-period-past { background: #DDB8BC; }
.dot-rest { background: var(--color-rest); }

.legend-card {
  margin-top: 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  padding: 12rpx 24rpx;
  box-shadow: var(--shadow-soft);
}

.legend-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.legend-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 0;
}

.legend-arrow {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.legend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(240, 138, 155, 0.05);
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot.period {
  background: var(--color-red);
}

.legend-dot.rest {
  background: var(--color-blue);
}

.legend-dot.todo {
  background: var(--color-text-secondary);
}

.legend-dot.event {
  background: var(--color-accent);
}

.error-text {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-danger);
}

.day-panel {
  margin-top: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.day-title {
  font-size: 30rpx;
  font-weight: 600;
}

.status-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-red);
}

.status-line.rest {
  color: var(--color-blue);
}

.day-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.todo-item,
.event-item {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  position: relative;
  overflow: hidden;
}

.todo-item.done .todo-title {
  color: var(--color-text-secondary);
  text-decoration: line-through;
}

.todo-title,
.event-title {
  font-size: 28rpx;
  color: var(--color-text);
}

.todo-meta,
.event-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.cat-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

/* 分类色条 + 图标浅底（同色系不同明度，V2） */
.cat-todo .cat-bar { background: var(--color-todo); }
.cat-meal .cat-bar { background: var(--color-meal); }
.cat-restaurant .cat-bar { background: var(--color-restaurant); }
.cat-anniversary .cat-bar { background: var(--color-anniversary); }
.cat-trip .cat-bar { background: var(--color-travel); }
.cat-period .cat-bar { background: var(--color-period); }
.cat-custom .cat-bar { background: var(--color-todo); }

.cat-todo .item-icon { background: var(--tag-todo); }
.cat-meal .item-icon { background: var(--tag-meal); }
.cat-restaurant .item-icon { background: var(--tag-restaurant); }
.cat-anniversary .item-icon { background: var(--tag-anniversary); }
.cat-trip .item-icon { background: var(--tag-travel); }
.cat-period .item-icon { background: var(--tag-period); }
.cat-custom .item-icon { background: var(--tag-todo); }

.item-icon {
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
}

.item-body {
  flex: 1;
  min-width: 0;
}

.add-btn {
  margin-top: 28rpx;
}

.form {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.form-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input {
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
}

.period-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.period-card-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.period-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.period-row:last-child {
  border-bottom: none;
}

.period-range {
  font-size: 28rpx;
  color: var(--color-text);
}

.period-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.period-delete {
  font-size: 26rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}

.period-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---- 顶部：双人爱心 + 邀请码（1.0.3 UI 优化） ---- */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.couple {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-avatar {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 18rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
}

.mini-avatar.me {
  background: rgba(240, 138, 155, 0.10);
}

/* 右上角小 ✏️：常驻改名入口，不占布局、不遮挡 */
.edit-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  font-size: 20rpx;
  line-height: 1;
  background: var(--color-surface);
  border-radius: 50%;
  padding: 4rpx 6rpx;
  box-shadow: var(--shadow-soft);
}

.mini-emoji {
  font-size: 30rpx;
}

.mini-name {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text);
  max-width: 130rpx;
  overflow: hidden;
  white-space: nowrap;
}

/* 昵称过长时用“弹幕滚轮”效果完整展示（1.0.12） */
.mini-name.long {
  display: inline-block;
  padding-left: 24rpx;
  animation: name-marquee 8s linear infinite;
}

@keyframes name-marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}

.heart {
  font-size: 32rpx;
}

.invite-badge {
  padding: 8rpx 16rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--color-primary-deep);
  font-weight: 600;
  box-shadow: var(--shadow-soft);
}

.invite-badge.bound {
  font-size: 28rpx;
}

/* ---- 游客模式（v1.1.6） ---- */
.guest-badge {
  padding: 10rpx 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
  box-shadow: var(--shadow-soft);
}

.guest-actions {
  display: flex;
  gap: 12rpx;
}

.guest-btn {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  color: var(--color-primary-deep);
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--color-border);
  box-shadow: var(--shadow-soft);
  font-weight: 600;
}

.guest-btn.primary {
  color: #ffffff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.guest-error {
  margin: 0 0 16rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #C97F3E;
  background: rgba(224, 162, 107, 0.14);
  border-radius: var(--radius-sm);
  text-align: center;
}

.guest-tip .legend-title {
  font-size: 24rpx;
  color: var(--color-primary-deep);
}

.guest-tip-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ---- 事件数量角标 ---- */
.event-count {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #ffffff;
  background: var(--color-primary);
  border-radius: 999rpx;
  padding: 0 6rpx;
}

/* ---- 图例 ---- */
.legend-dot.meal { background: var(--color-meal); }
.legend-dot.restaurant { background: var(--color-restaurant); }
.legend-dot.anniversary { background: var(--color-anniversary); }
.legend-dot.trip { background: var(--color-travel); }
.legend-dot.period-ongoing {
  background: var(--color-period);
}

.legend-dot.period-predicted {
  background: #F3A8B5;
}

.legend-dot.period-past {
  background: #DDB8BC;
}

.legend-dot.weekend {
  background: #A79FC4;
}

.legend-dot.makeup {
  background: #E8935A;
}

/* ---- 当天详情：标识 chips + 状态行 ---- */
.mark-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mark-chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-red);
  background: rgba(214, 82, 82, 0.10);
}

.mark-chip.makeup {
  color: #D97B2B;
  background: rgba(235, 146, 89, 0.16);
}

.mark-chip.weekend {
  color: #8A8198;
  background: rgba(150, 141, 170, 0.12);
}

.status-line.period-ongoing {
  color: #D9534F;
}

.status-line.period-predicted {
  color: #D97A8E;
}

.status-line.period-past {
  color: #B98F94;
}

/* ---- 快速入口 ---- */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.quick-btn {
  flex: 0 0 calc((100% - 28rpx) / 3);
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  text-align: center;
  color: var(--color-primary-deep);
  background: rgba(240, 138, 155, 0.08);
  border-radius: var(--radius-pill);
  border: 2rpx solid rgba(240, 138, 155, 0.18);
  font-weight: 500;
}

.quick-btn:active {
  background: rgba(240, 138, 155, 0.16);
}

/* ---- 昵称编辑 ---- */
.name-edit {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.name-edit-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.name-edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.name-edit-btn {
  flex: 1;
  font-size: 28rpx;
}

/* ---- 日期/时间表盘选择 ---- */
.picker-value {
  background: #FFF9F4;
  border: 2rpx solid #FBE9DC;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.picker-value.placeholder {
  color: var(--color-text-secondary);
}
