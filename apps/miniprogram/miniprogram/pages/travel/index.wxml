<view class="container {{themeClass}} travel-page">
  <view class="page-head">
    <view class="page-title">旅游计划</view>
    <view class="page-sub">两个人的下一站</view>
  </view>

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <view class="card">
    <view class="card-title">本月行程（14 天后自动进回收站）</view>
    <view class="empty" wx:if="{{!plans.length}}">还没有行程，点“安排行程”</view>
    <view class="plan-row" wx:for="{{plans}}" wx:key="id">
      <view class="plan-left">
        <view class="plan-name">✈️ {{item.name}}</view>
        <view class="plan-meta">{{item.dateLabel}} {{item.timeLabel}}{{item.note ? ' · ' + item.note : ''}}</view>
      </view>
      <view class="plan-actions">
        <view class="link-btn" data-plan-id="{{item.id}}" bindtap="onShowPlanForm">编辑</view>
        <view class="link-btn" data-id="{{item.id}}" bindtap="onOfflinePlan">下架</view>
        <view class="link-btn danger" wx:if="{{isOwner}}" data-id="{{item.id}}" bindtap="onDeletePlan">删除</view>
      </view>
    </view>
  </view>

  <view class="empty-list" wx:if="{{!trips.length && !loading}}">永久旅行资料会显示在这里（不自动清理）</view>
  <view class="trip-card" wx:for="{{trips}}" wx:key="id">
    <image class="cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="trip-body">
      <view class="trip-head">
        <view class="trip-name">🧳 {{item.name}}</view>
        <view class="trip-actions">
          <view class="chip" data-id="{{item.id}}" bindtap="onShowTripForm">编辑</view>
          <view class="chip danger" wx:if="{{isOwner}}" data-id="{{item.id}}" bindtap="onDeleteTrip">删除</view>
        </view>
      </view>
      <view class="trip-meta" wx:if="{{item.placeLabel}}">📍 {{item.placeLabel}}</view>
      <view class="trip-meta" wx:if="{{item.visitedDate}}">🗓️ 去过：{{item.visitedDate}}</view>
      <view class="trip-actions-row">
        <view class="chip" data-trip-id="{{item.id}}" bindtap="onShowPlanForm">✈️ 安排行程</view>
        <view class="chip" data-id="{{item.id}}" bindtap="onShowTripForm">✏️ 编辑</view>
      </view>
    </view>
  </view>

  <view class="btn-row">
    <button class="btn-primary flex-btn" bindtap="onShowTripForm">＋ 添加旅行资料</button>
    <button class="btn-secondary flex-btn" bindtap="onShowPlanForm">安排行程</button>
  </view>

  <!-- 旅行资料表单 -->
  <view class="modal" wx:if="{{showTripForm}}">
    <view class="mask" bindtap="onHideTripForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">{{editingTripId ? '编辑目的地' : '添加目的地'}}</view>
      <view class="field-label">国家（可搜索）</view>
      <textarea class="input textarea auto-grow" placeholder="如：日本 / 泰国 / 中国大陆" value="{{tCountry}}" bindinput="onCountryInput" bindblur="onCountryBlur" maxlength="30" auto-height />
      <view class="suggest" wx:if="{{showCountryList && countryOptions.length}}">
        <view class="suggest-item" wx:for="{{countryOptions}}" wx:key="*this" data-name="{{item}}" bindtap="onPickCountry">{{item}}</view>
      </view>
      <view class="field-label">城市（可搜索）</view>
      <textarea class="input textarea auto-grow" placeholder="如：东京 / 首尔 / 上海" value="{{tCity}}" bindinput="onCityInput" bindblur="onCityBlur" maxlength="30" auto-height />
      <view class="suggest" wx:if="{{showCityList && cityOptions.length}}">
        <view class="suggest-item" wx:for="{{cityOptions}}" wx:key="*this" data-name="{{item}}" bindtap="onPickCity">{{item}}</view>
      </view>
      <view class="field-label">去过的日期（可选）</view>
      <picker mode="date" value="{{tVisitedDate}}" bindchange="onFieldChange" data-field="tVisitedDate">
        <view class="picker-value {{tVisitedDate ? '' : 'placeholder'}}">{{tVisitedDate || '选择日期'}}</view>
      </picker>
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideTripForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onSaveTrip" loading="{{savingTrip}}" disabled="{{savingTrip}}">保存</button>
      </view>
    </view>
  </view>

  <!-- 临时行程表单 -->
  <view class="modal" wx:if="{{showPlanForm}}">
    <view class="mask" bindtap="onHidePlanForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">{{editingPlanId ? '编辑行程' : '安排行程'}}（14 天后自动进回收站）</view>
      <view class="field-label">关联旅行资料</view>
      <picker range="{{trips}}" range-key="name" value="{{pTripIndex}}" bindchange="onTripPickerChange">
        <view class="picker-value {{pTripIndex > 0 ? '' : 'placeholder'}}">{{pTripIndex > 0 ? '关联：' + trips[pTripIndex - 1].name : '不关联（自定义名称）'}}</view>
      </picker>
      <view class="field-label">行程名称</view>
      <textarea class="input textarea auto-grow" placeholder="默认用关联资料名" value="{{pName}}" data-field="pName" bindinput="onFieldInput" maxlength="60" auto-height />
      <view class="form-row">
        <view class="form-col">
          <view class="field-label">开始日期 *</view>
          <picker mode="date" value="{{pStart}}" bindchange="onFieldChange" data-field="pStart">
            <view class="picker-value {{pStart ? '' : 'placeholder'}}">{{pStart || '选择'}}</view>
          </picker>
        </view>
        <view class="form-col">
          <view class="field-label">结束日期（可选）</view>
          <picker mode="date" value="{{pEnd}}" bindchange="onFieldChange" data-field="pEnd">
            <view class="picker-value {{pEnd ? '' : 'placeholder'}}">{{pEnd || '选择'}}</view>
          </picker>
        </view>
      </view>
      <view class="form-row">
        <view class="form-col">
          <view class="field-label">时间（可选）</view>
          <picker mode="time" value="{{pTime}}" bindchange="onFieldChange" data-field="pTime">
            <view class="picker-value {{pTime ? '' : 'placeholder'}}">{{pTime || '选时间'}}</view>
          </picker>
        </view>
        <view class="form-col today-col">
          <view class="field-label">快捷</view>
          <button class="btn-secondary today-btn" bindtap="onPlanDateToday">今天</button>
        </view>
      </view>
      <view class="field-label">备注（可选）</view>
      <textarea class="input textarea auto-grow" placeholder="备注（可选）" value="{{pNote}}" data-field="pNote" bindinput="onFieldInput" maxlength="200" auto-height />
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHidePlanForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onSavePlan" loading="{{savingPlan}}" disabled="{{savingPlan}}">保存</button>
      </view>
    </view>
  </view>
</view>
