.travel-page {
  padding-bottom: 64rpx;
}

.page-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
}

.page-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.error-text {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-danger);
}

.empty,
.empty-list {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.plan-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.plan-row:last-child {
  border-bottom: none;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 500;
}

.plan-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.plan-actions {
  display: flex;
  gap: 12rpx;
}

.link-btn {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 12rpx;
}

.link-btn.danger,
.chip.danger {
  color: var(--color-danger);
}

.trip-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 280rpx;
  background: var(--color-bg);
}

.trip-body {
  padding: 24rpx;
}

.trip-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.trip-name {
  font-size: 32rpx;
  font-weight: 600;
}

.trip-actions {
  display: flex;
  gap: 12rpx;
}

.trip-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.trip-actions-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-bg);
  border-radius: 999rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.flex-btn {
  flex: 1;
  font-size: 28rpx;
}

.form {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.input {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
}

.textarea.tall {
  min-height: 200rpx;
}

.two-col {
  display: flex;
  gap: 16rpx;
}

.two-col .input {
  flex: 1;
}

.picker-value {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  color: var(--color-text);
}

.today-btn {
  font-size: 26rpx;
  width: 140rpx;
  margin-bottom: 16rpx;
}

.photo-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

.upload-btn {
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
}

/* 韩风可爱（第九阶段） */
.trip-card {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.plan-row {
  border-bottom: 2rpx dashed var(--color-border);
}
