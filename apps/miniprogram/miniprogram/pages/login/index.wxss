.login-page {
  justify-content: space-between;
  padding-bottom: 96rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.logo {
  font-size: 96rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text);
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.login-btn {
  margin-top: 80rpx;
}

.error-text {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-danger);
  line-height: 1.6;
  word-break: break-all;
}

.privacy {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
