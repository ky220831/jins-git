.tip {
  font-size: 30rpx;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.input {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 40rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.submit {
  margin-top: 32rpx;
}
