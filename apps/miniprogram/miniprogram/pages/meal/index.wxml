<view class="container {{themeClass}} meal-page">
  <view class="page-head">
    <view class="page-title">今日菜单</view>
    <view class="page-date">{{todayDate}}</view>
  </view>

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <view class="card">
    <view class="card-title">今天的安排</view>
    <view class="empty" wx:if="{{!todayPlans.length}}">今天还没有菜单，随机选一个或手动上架</view>
    <view class="plan-row" wx:for="{{todayPlans}}" wx:key="id">
      <view class="plan-left">
        <view class="plan-name">{{item.name}}</view>
        <view class="plan-meta">{{item.timeLabel}}{{item.category ? ' · ' + item.category : ''}}</view>
        <view class="plan-note" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
      <view class="plan-actions">
        <view class="link-btn" data-id="{{item.id}}" bindtap="onOfflinePlan">下架</view>
        <view class="link-btn danger" wx:if="{{isOwner}}" data-id="{{item.id}}" bindtap="onDeletePlan">删除</view>
      </view>
    </view>
    <view class="btn-row">
      <button class="btn-primary flex-btn" bindtap="onRandom">随机选一个</button>
      <button class="btn-secondary flex-btn" bindtap="onShowPlanForm">上架菜单</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title">预选素材库（永久保存，随机从这里选）</view>
    <view class="empty" wx:if="{{!templates.length}}">还没有素材，先添加几个常做的菜吧</view>
    <view class="template-row" wx:for="{{templates}}" wx:key="id">
      <view class="template-left">
        <view class="template-name">{{item.name}}</view>
        <view class="template-meta">{{item.category || '未分类'}} · {{item.enabled ? '参与随机' : '已停用'}}</view>
      </view>
      <view class="template-actions">
        <switch checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="onToggleTemplate" color="#D98E8E" />
        <view class="link-btn" data-id="{{item.id}}" bindtap="onEditTemplate">编辑</view>
        <view class="link-btn danger" wx:if="{{isOwner}}" data-id="{{item.id}}" bindtap="onDeleteTemplate">删除</view>
      </view>
    </view>
    <button class="btn-secondary add-btn" bindtap="onShowTemplateForm">＋ 添加素材</button>
  </view>

  <view class="card" wx:if="{{isOwner}}">
    <view class="card-title">回收站（72 小时内可恢复，仅主账号可见）</view>
    <view class="empty" wx:if="{{!trashItems.length}}">回收站是空的</view>
    <view class="trash-row" wx:for="{{trashItems}}" wx:key="id">
      <view class="trash-left">
        <view class="trash-title">{{item.title}}</view>
        <view class="trash-meta">{{item.collection === 'meal_plans' ? '菜单' : item.collection === 'restaurants' ? '餐厅' : item.collection === 'restaurant_visits' ? '餐厅行程' : '素材'}} · {{item.deleteReason === 'auto_expire' ? '自动过期' : '手动删除'}} · {{item.retentionType === 'temporary' ? '临时' : '永久'}}</view>
      </view>
      <view class="trash-actions">
        <view class="link-btn" data-id="{{item.id}}" bindtap="onRestoreTrash">恢复</view>
        <view class="link-btn danger" data-id="{{item.id}}" bindtap="onPurgeTrash">永久删除</view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showPlanForm}}">
    <view class="mask" bindtap="onHidePlanForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">上架菜单</view>
      <picker class="picker" range="{{enabledTemplates}}" range-key="name" value="{{templatePickerIndex}}" bindchange="onTemplatePick">
        <view class="picker-value {{templatePickerIndex < 0 ? 'placeholder' : ''}}">{{templatePickerIndex >= 0 ? enabledTemplates[templatePickerIndex].name : '从素材库选择（可选）'}}</view>
      </picker>
      <view class="field-label">名称</view>
      <textarea class="input textarea auto-grow" placeholder="如：番茄炒蛋" value="{{planName}}" bindinput="onPlanNameInput" maxlength="50" auto-height />
      <view class="form-row">
        <view class="form-col">
          <view class="field-label">日期</view>
          <picker mode="date" value="{{planDate}}" bindchange="onPlanDateChange">
            <view class="picker-value">{{planDate}}</view>
          </picker>
        </view>
        <view class="form-col">
          <view class="field-label">时间（可选）</view>
          <picker mode="time" value="{{planTime}}" bindchange="onPlanTimeChange">
            <view class="picker-value {{planTime ? '' : 'placeholder'}}">{{planTime || '选时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="field-label">备注（可选）</view>
      <textarea class="input textarea auto-grow" placeholder="备注" value="{{planNote}}" bindinput="onPlanNoteInput" maxlength="200" auto-height />
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHidePlanForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onAddPlan" loading="{{saving}}" disabled="{{saving}}">保存</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showTemplateForm}}">
    <view class="mask" bindtap="onHideTemplateForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">{{editingTemplateId ? '编辑素材' : '添加素材'}}</view>
      <view class="field-label">菜谱名称</view>
      <textarea class="input textarea auto-grow" placeholder="菜谱名称" value="{{templateName}}" bindinput="onTemplateNameInput" maxlength="50" auto-height />
      <view class="field-label">分类（可选）</view>
      <textarea class="input textarea auto-grow" placeholder="如：家常菜/早餐" value="{{templateCategory}}" bindinput="onTemplateCategoryInput" maxlength="20" auto-height />
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideTemplateForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onSaveTemplate" loading="{{saving}}" disabled="{{saving}}">保存</button>
      </view>
    </view>
  </view>
</view>
