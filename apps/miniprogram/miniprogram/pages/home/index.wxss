.home-page {
  padding-bottom: 80rpx;
}

.loading {
  padding-top: 160rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.error-box {
  padding-top: 160rpx;
  text-align: center;
}

.error-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.error-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  word-break: break-all;
}

.retry-btn {
  margin-top: 32rpx;
}

/* ---- 顶部：双人爱心 + 邀请码 ---- */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.couple {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
}

.mini-avatar.me {
  background: #FFE9EC;
}

.mini-emoji {
  font-size: 34rpx;
}

.mini-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text);
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.heart {
  font-size: 36rpx;
}

.invite-badge {
  padding: 10rpx 18rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-primary-deep);
  font-weight: 600;
  box-shadow: var(--shadow-soft);
}

.invite-badge.bound {
  font-size: 30rpx;
}

/* ---- 功能列 ---- */
.feature-list {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.feature-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx dashed var(--color-border);
}

.feature-row:last-child {
  border-bottom: none;
}

.feature-row:active {
  background: #FFF9F4;
}

.fe-emoji {
  font-size: 40rpx;
  width: 64rpx;
  text-align: center;
}

.fe-body {
  flex: 1;
}

.fe-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.fe-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.fe-arrow {
  font-size: 36rpx;
  color: var(--color-text-secondary);
}

/* ---- 昵称编辑 ---- */
.name-edit {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.name-edit-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.name-edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.name-edit-btn {
  flex: 1;
  font-size: 28rpx;
}
