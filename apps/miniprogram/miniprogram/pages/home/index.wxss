.loading {
  padding-top: 120rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.space-name {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text);
}

.role-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 24rpx;
}

.member {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.member:last-child {
  border-bottom: none;
}

.member-role {
  font-size: 30rpx;
  font-weight: 500;
}

.member-id {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.member-time {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.invite-code {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--color-primary);
}

.invite-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.bound {
  font-size: 32rpx;
  color: var(--color-success);
  font-weight: 500;
}
