<view class="container home-page">
  <block wx:if="{{loading}}">
    <view class="loading">🌷 加载中…</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="error-box">
      <view class="error-title">🥺 页面加载失败</view>
      <view class="error-text">{{error}}</view>
      <button class="btn-secondary retry-btn" bindtap="onRetry">重试</button>
    </view>
  </block>

  <block wx:elif="{{space}}">
    <!-- 顶部：双人爱心连接 + 右上角小邀请码 -->
    <view class="top-bar">
      <view class="couple">
        <view class="mini-avatar me" bindtap="onStartEditName">
          <text class="mini-emoji">{{isOwner ? '👑' : '💗'}}</text>
          <text class="mini-name">{{myDisplayName}}</text>
        </view>
        <view class="heart">❤️</view>
        <view class="mini-avatar">
          <text class="mini-emoji">{{isOwner ? '💗' : '👑'}}</text>
          <text class="mini-name">{{partnerDisplayName}}</text>
        </view>
      </view>
      <view class="invite-badge" wx:if="{{isOwner && inviteCode}}" bindtap="onCopyInvite">🔑 {{inviteCode}}</view>
      <view class="invite-badge bound" wx:if="{{!inviteCode}}">💗</view>
    </view>

    <!-- 日历（首页核心） -->
    <month-calendar />

    <!-- 功能列 -->
    <view class="feature-list">
      <view class="feature-row" bindtap="onOpenFullCalendar">
        <text class="fe-emoji">📅</text>
        <view class="fe-body">
          <view class="fe-label">完整日历</view>
          <view class="fe-sub">添加事项 · 记录生理期</view>
        </view>
        <text class="fe-arrow">›</text>
      </view>
      <view class="feature-row" bindtap="onOpenMeal">
        <text class="fe-emoji">🍚</text>
        <view class="fe-body">
          <view class="fe-label">今日菜单</view>
          <view class="fe-sub">今天吃什么 · 随机选</view>
        </view>
        <text class="fe-arrow">›</text>
      </view>
      <view class="feature-row" bindtap="onOpenRestaurant">
        <text class="fe-emoji">🍴</text>
        <view class="fe-body">
          <view class="fe-label">漂亮饭</view>
          <view class="fe-sub">两个人的餐厅收藏库</view>
        </view>
        <text class="fe-arrow">›</text>
      </view>
      <view class="feature-row" bindtap="onOpenAnniversary">
        <text class="fe-emoji">❤️</text>
        <view class="fe-body">
          <view class="fe-label">纪念日</view>
          <view class="fe-sub">重要的日子</view>
        </view>
        <text class="fe-arrow">›</text>
      </view>
      <view class="feature-row" bindtap="onOpenTravel">
        <text class="fe-emoji">✈️</text>
        <view class="fe-body">
          <view class="fe-label">旅游计划</view>
          <view class="fe-sub">我们的下一站</view>
        </view>
        <text class="fe-arrow">›</text>
      </view>
      <view class="feature-row" bindtap="onOpenManage">
        <text class="fe-emoji">🛠️</text>
        <view class="fe-body">
          <view class="fe-label">管理</view>
          <view class="fe-sub">{{isOwner ? '主管理 · 回收站 · 导出' : '副管理'}}</view>
        </view>
        <text class="fe-arrow">›</text>
      </view>
    </view>

    <!-- 昵称编辑 -->
    <view class="name-edit" wx:if="{{showNameEdit}}">
      <view class="name-edit-title">改我的昵称</view>
      <input class="input" placeholder="输入昵称（最多 16 字）" value="{{nameInput}}" bindinput="onNameInput" maxlength="16" />
      <view class="name-edit-actions">
        <button class="btn-secondary name-edit-btn" bindtap="onHideNameEdit">取消</button>
        <button class="btn-primary name-edit-btn" bindtap="onSaveName" loading="{{savingName}}" disabled="{{savingName}}">保存</button>
      </view>
    </view>
  </block>
</view>
