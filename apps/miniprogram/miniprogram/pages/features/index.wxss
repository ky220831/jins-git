.features-page {
  padding-bottom: 80rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.error-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-danger);
  text-align: center;
}

.feature-list {
  margin-top: 8rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx;
  margin-top: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.feature-card:active {
  transform: scale(0.98);
}

.fe-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.ic-meal { background: var(--tag-meal); }
.ic-restaurant { background: var(--tag-restaurant); }
.ic-anniversary { background: var(--tag-anniversary); }
.ic-travel { background: var(--tag-travel); }
.ic-period { background: var(--tag-period); }
.ic-manage { background: var(--tag-todo); }

.fe-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.fe-body {
  flex: 1;
}

.fe-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.fe-arrow {
  font-size: 40rpx;
  color: var(--color-text-secondary);
}

.tip-card {
  margin-top: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary-deep);
}

.tip-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}
