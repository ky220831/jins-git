.features-page {
  padding-bottom: 140rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.error-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-danger);
  text-align: center;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 8rpx;
}

.feature-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  padding: 32rpx 16rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.feature-card:active {
  transform: scale(0.97);
}

.fe-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.ic-meal { background: var(--tag-meal); }
.ic-restaurant { background: var(--tag-restaurant); }
.ic-anniversary { background: var(--tag-anniversary); }
.ic-travel { background: var(--tag-travel); }
.ic-period { background: var(--tag-period); }
.ic-manage { background: var(--tag-todo); }

.fe-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
}

.fe-sub {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.4;
}

.tip-card {
  margin-top: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary-deep);
}

.tip-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}
