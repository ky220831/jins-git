.features-page {
  padding-bottom: 80rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.error-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-danger);
  text-align: center;
}

.feature-list {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.feature-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-bottom: 2rpx dashed var(--color-border);
}

.feature-row:last-child {
  border-bottom: none;
}

.feature-row:active {
  background: #FFF9F4;
}

.fe-emoji {
  font-size: 44rpx;
  width: 68rpx;
  text-align: center;
}

.fe-body {
  flex: 1;
}

.fe-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.fe-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.fe-arrow {
  font-size: 36rpx;
  color: var(--color-text-secondary);
}

.tip-card {
  margin-top: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary-deep);
}

.tip-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}
