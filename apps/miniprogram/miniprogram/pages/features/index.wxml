<view class="container {{themeClass}} features-page">
  <view class="page-head">
    <view class="page-title">功能</view>
    <view class="page-sub">日历在左侧 Tab · 点这里进入各功能</view>
  </view>

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <view class="feature-list">
    <view class="feature-card" bindtap="onOpenMeal">
      <view class="fe-icon ic-meal">🍚</view>
      <view class="fe-body">
        <view class="fe-label">今日菜单</view>
        <view class="fe-sub">今天想吃什么 · 随机选 · 素材库</view>
      </view>
      <text class="fe-arrow">›</text>
    </view>
    <view class="feature-card" bindtap="onOpenRestaurant">
      <view class="fe-icon ic-restaurant">🍴</view>
      <view class="fe-body">
        <view class="fe-label">漂亮饭</view>
        <view class="fe-sub">收藏想去的餐厅 · 行程 · 搜索</view>
      </view>
      <text class="fe-arrow">›</text>
    </view>
    <view class="feature-card" bindtap="onOpenAnniversary">
      <view class="fe-icon ic-anniversary">❤️</view>
      <view class="fe-body">
        <view class="fe-label">纪念日</view>
        <view class="fe-sub">属于我们的日子 · 每年重复</view>
      </view>
      <text class="fe-arrow">›</text>
    </view>
    <view class="feature-card" bindtap="onOpenTravel">
      <view class="fe-icon ic-travel">✈️</view>
      <view class="fe-body">
        <view class="fe-label">旅游计划</view>
        <view class="fe-sub">去过的国家和城市</view>
      </view>
      <text class="fe-arrow">›</text>
    </view>
    <view class="feature-card" bindtap="onOpenPeriod">
      <view class="fe-icon ic-period">🌸</view>
      <view class="fe-body">
        <view class="fe-label">生理期</view>
        <view class="fe-sub">记录与预测 · 日历显示开关</view>
      </view>
      <text class="fe-arrow">›</text>
    </view>
    <view class="feature-card" bindtap="onOpenManage">
      <view class="fe-icon ic-manage">🛠️</view>
      <view class="fe-body">
        <view class="fe-label">管理</view>
        <view class="fe-sub">{{isOwner ? '回收站 · 数据 · 家庭' : '副管理'}}</view>
      </view>
      <text class="fe-arrow">›</text>
    </view>
  </view>

  <view class="tip-card">
    <view class="tip-title">💡 小贴士</view>
    <view class="tip-text">在“日历”里点某一天，可以直接为该天添加菜单、餐厅行程、旅游行程或纪念日。</view>
  </view>

  <view class="tip-card">
    <view class="toggle-row">
      <view>
        <view class="tip-title">🎨 随时节自动换肤</view>
        <view class="tip-text">跟随二十四节气与昼夜自动切换配色；关闭后锁定基础风格</view>
      </view>
      <switch checked="{{themeAuto}}" bindchange="onToggleTheme" color="#F08A9B" />
    </view>
  </view>
</view>
