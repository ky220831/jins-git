<view class="container {{themeClass}} restaurant-page">
  <view class="page-head">
    <view class="page-title">下馆子</view>
    <view class="page-sub">两个人的餐厅收藏库</view>
  </view>

  <view class="error-text" wx:if="{{error}}">{{error}}</view>

  <view class="card">
    <view class="card-title">本月行程（14 天后自动进回收站）</view>
    <view class="empty" wx:if="{{!visits.length}}">还没有安排，点餐厅上的“安排去”</view>
    <view class="visit-row" wx:for="{{visits}}" wx:key="id">
      <view class="visit-left">
        <view class="visit-name">🍴 {{item.name}}</view>
        <view class="visit-meta">{{item.date}} {{item.timeLabel}}{{item.note ? ' · ' + item.note : ''}}</view>
      </view>
      <view class="visit-actions">
        <view class="link-btn" data-id="{{item.id}}" bindtap="onOfflineVisit">下架</view>
        <view class="link-btn danger" wx:if="{{isOwner}}" data-id="{{item.id}}" bindtap="onDeleteVisit">删除</view>
      </view>
    </view>
  </view>

  <view class="empty-list" wx:if="{{!restaurants.length && !loading}}">收藏的餐厅会显示在这里</view>
  <view class="restaurant-card" wx:for="{{restaurants}}" wx:key="id">
    <image class="cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="restaurant-body">
      <view class="restaurant-head">
        <view class="restaurant-name">{{item.name}}</view>
        <view class="fav" data-id="{{item.id}}" data-field="favorite" bindtap="onToggleRestaurant">{{item.favorite ? '❤️' : '🤍'}}</view>
      </view>
      <view class="restaurant-meta">
        <text wx:if="{{item.category}}">{{item.category}}</text>
        <text wx:if="{{item.priceLabel}}"> · {{item.priceLabel}}</text>
        <text wx:if="{{item.ratingLabel}}"> · {{item.ratingLabel}}</text>
        <text wx:if="{{item.visited}}"> · 已去过</text>
        <text wx:if="{{!item.enabled}}"> · 已收起</text>
      </view>
      <view class="restaurant-meta" wx:if="{{item.address}}">{{item.address}}</view>
      <view class="restaurant-meta" wx:if="{{item.tagsLabel}}">{{item.tagsLabel}}</view>
      <view class="restaurant-actions">
        <view class="chip" data-id="{{item.id}}" bindtap="onEditRestaurant">编辑</view>
        <view class="chip" data-id="{{item.id}}" bindtap="onShowVisitForm">安排去</view>
        <view class="chip" data-id="{{item.id}}" bindtap="onHowToGo">怎么去</view>
        <view class="chip danger" wx:if="{{isOwner}}" data-id="{{item.id}}" bindtap="onDeleteRestaurant">删除</view>
      </view>
      <view class="photo-actions">
        <view class="chip small" data-id="{{item.id}}" data-field="cover" bindtap="onUploadImage">封面</view>
        <view class="chip small" data-id="{{item.id}}" data-field="images" bindtap="onUploadImage">餐厅照片</view>
        <view class="chip small" data-id="{{item.id}}" data-field="menuImages" bindtap="onUploadImage">菜单图片</view>
      </view>
    </view>
  </view>

  <view class="btn-row">
    <button class="btn-primary flex-btn" bindtap="onShowForm">＋ 添加餐厅</button>
    <button class="btn-secondary flex-btn" bindtap="onShowSearch">搜索导入</button>
    <button class="btn-secondary flex-btn" bindtap="onOcr">菜单 OCR</button>
  </view>

  <!-- 搜索 -->
  <view class="modal" wx:if="{{showSearch}}">
    <view class="mask" bindtap="onHideSearch"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">搜索餐厅（腾讯位置服务）</view>
      <view class="field-label">关键词</view>
      <textarea class="input textarea auto-grow" placeholder="如：日料 / 店名" value="{{searchKeyword}}" bindinput="onSearchKeyword" maxlength="30" auto-height />
      <view class="field-label">城市（可选）</view>
      <textarea class="input textarea auto-grow" placeholder="默认全国" value="{{searchRegion}}" bindinput="onSearchRegion" maxlength="20" auto-height />
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideSearch">取消</button>
        <button class="btn-primary form-btn" bindtap="onSearch" loading="{{searching}}" disabled="{{searching}}">搜索</button>
      </view>
      <view class="search-result" wx:for="{{searchResults}}" wx:key="id" data-index="{{index}}" bindtap="onImportSearch">
        <view class="search-name">{{item.name}}</view>
        <view class="search-meta">{{item.address}}{{item.district ? ' · ' + item.district : ''}}{{item.category ? ' · ' + item.category : ''}}</view>
      </view>
    </view>
  </view>

  <!-- 餐厅表单 -->
  <view class="modal" wx:if="{{showForm}}">
    <view class="mask" bindtap="onHideForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">{{editingId ? '编辑餐厅' : '添加餐厅'}}</view>
      <view class="ocr-hint" wx:if="{{ocrHint}}">{{ocrHint}}</view>
      <view class="field-label">餐厅名称 *</view>
      <textarea class="input textarea auto-grow" placeholder="餐厅名称 *" value="{{fName}}" data-field="fName" bindinput="onFieldInput" maxlength="60" auto-height />
      <view class="field-label">地址</view>
      <textarea class="input textarea auto-grow" placeholder="地址" value="{{fAddress}}" data-field="fAddress" bindinput="onFieldInput" maxlength="200" auto-height />
      <view class="form-row">
        <view class="form-col">
          <view class="field-label">城市</view>
          <textarea class="input textarea auto-grow" placeholder="城市" value="{{fCity}}" data-field="fCity" bindinput="onFieldInput" maxlength="20" auto-height />
        </view>
        <view class="form-col">
          <view class="field-label">分类</view>
          <textarea class="input textarea auto-grow" placeholder="如：日料/火锅" value="{{fCategory}}" data-field="fCategory" bindinput="onFieldInput" maxlength="20" auto-height />
        </view>
      </view>
      <view class="category-chips">
        <view class="cat-chip {{fCategory === cat ? 'active' : ''}}" wx:for="{{categoryOptions}}" wx:key="*this" data-cat="{{item}}" bindtap="onPickCategory">{{item}}</view>
      </view>
      <!-- 更多信息：默认折叠，只保留 推荐菜 / 备注 -->
      <view class="advanced-toggle" bindtap="onToggleAdvanced">
        <text>{{showAdvanced ? '收起更多信息 ▴' : '更多信息 ▾'}}</text>
      </view>
      <view class="restore-tip" wx:if="{{editingId && !fEnabled}}">
        <text>这家餐厅已被收起</text>
        <view class="link-btn" bindtap="onRestoreEnabled">重新展示</view>
      </view>
      <block wx:if="{{showAdvanced}}">
        <view class="field-label">推荐菜</view>
        <textarea class="input textarea auto-grow" placeholder="推荐菜，逗号分隔" value="{{fDishes}}" data-field="fDishes" bindinput="onFieldInput" maxlength="200" auto-height />
        <view class="field-label">备注（可选）</view>
        <textarea class="input textarea" placeholder="备注（可选）" value="{{fNote}}" data-field="fNote" bindinput="onFieldInput" maxlength="500" />
      </block>
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onSaveRestaurant" loading="{{saving}}" disabled="{{saving}}">保存</button>
      </view>
    </view>
  </view>

  <!-- 行程表单 -->
  <view class="modal" wx:if="{{showVisitForm}}">
    <view class="mask" bindtap="onHideVisitForm"></view>
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="form-title">安排去：{{visitRestaurantName}}</view>
      <view class="form-row">
        <view class="form-col">
          <view class="field-label">日期</view>
          <picker mode="date" value="{{vDate}}" bindchange="onFieldChange" data-field="vDate">
            <view class="picker-value">{{vDate}}</view>
          </picker>
        </view>
        <view class="form-col">
          <view class="field-label">时间（可选）</view>
          <picker mode="time" value="{{vTime}}" bindchange="onFieldChange" data-field="vTime">
            <view class="picker-value {{vTime ? '' : 'placeholder'}}">{{vTime || '选时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="field-label">备注（可选）</view>
      <textarea class="input textarea auto-grow" placeholder="备注" value="{{vNote}}" data-field="vNote" bindinput="onFieldInput" maxlength="200" auto-height />
      <view class="reminder-link" bindtap="onRemind">🔔 开启餐厅行程提醒</view>
      <view class="form-actions">
        <button class="btn-secondary form-btn" bindtap="onHideVisitForm">取消</button>
        <button class="btn-primary form-btn" bindtap="onSaveVisit">保存</button>
      </view>
    </view>
  </view>
</view>
